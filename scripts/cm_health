#!/usr/bin/env python3
"""
Health check for context-memory plugin.

This command checks common configuration issues and reports status.

Usage:
    cm_health              # Check all
    cm_health --verbose    # Detailed output

Exit code:
    0 = all checks passed
    1 = one or more checks failed
"""
import argparse
import json
import shutil
import subprocess
import sys
from pathlib import Path


def check_git(verbose: bool = False) -> bool:
    """Check if git is available."""
    try:
        result = subprocess.run(
            ["git", "--version"],
            capture_output=True,
            check=True,
            timeout=5
        )
        if verbose:
            version = result.stdout.decode().strip()
            print(f"✅ Git is available ({version})")
        else:
            print("✅ Git is available")
        return True
    except (FileNotFoundError, subprocess.CalledProcessError, subprocess.TimeoutExpired) as e:
        print("❌ Git not found - context-memory requires git")
        if verbose:
            print(f"   Error: {e}")
        return False


def check_write_permissions(verbose: bool = False) -> bool:
    """Check if we can write to .claude/context_memory."""
    try:
        test_dir = Path(".claude/context_memory/sessions")
        test_dir.mkdir(parents=True, exist_ok=True)

        test_file = test_dir / ".write_test"
        test_file.touch()
        test_file.unlink()

        if verbose:
            print(f"✅ Write permissions OK ({test_dir})")
        else:
            print("✅ Write permissions OK")
        return True
    except OSError as e:
        print(f"❌ Write permissions failed: {e}")
        if verbose:
            print(f"   Tried to create: {test_dir}")
        return False


def check_disk_space(verbose: bool = False) -> bool:
    """Check if there's enough disk space (>100MB)."""
    try:
        stat = shutil.disk_usage(".")
        free_mb = stat.free / (1024 * 1024)

        if free_mb > 100:
            if verbose:
                print(f"✅ Disk space OK ({free_mb:.0f}MB free)")
            else:
                print("✅ Disk space OK")
            return True
        else:
            print(f"⚠️  Low disk space ({free_mb:.0f}MB free)")
            if verbose:
                print("   Recommend at least 100MB free")
            return False
    except OSError as e:
        print(f"❌ Could not check disk space: {e}")
        return False


def check_hook_installed(verbose: bool = False) -> bool:
    """Check if PostToolUse hook is configured."""
    hook_file = Path(".claude/hooks.json")
    if not hook_file.exists():
        print("❌ Hook configuration not found (.claude/hooks.json)")
        return False

    try:
        config = json.loads(hook_file.read_text())
        post_tool_use = config.get("PostToolUse", [])

        # More robust check: look for exact command or script name
        hook_found = False
        for hook_entry in post_tool_use:
            if isinstance(hook_entry, dict):
                command = hook_entry.get("command", "")
                # Check if command contains cm_track_operation script
                if "cm_track_operation.py" in command or "cm_track_operation" in Path(command).name:
                    hook_found = True
                    break
            elif isinstance(hook_entry, str):
                if "cm_track_operation" in hook_entry:
                    hook_found = True
                    break

        if hook_found:
            if verbose:
                print("✅ PostToolUse hook configured")
            else:
                print("✅ Hook configured")
            return True
        else:
            print("⚠️  Hook file exists but cm_track_operation not in PostToolUse")
            if verbose:
                print(f"   Current PostToolUse: {post_tool_use}")
            return False
    except (json.JSONDecodeError, OSError) as e:
        print(f"❌ Could not read hook configuration: {e}")
        return False


def main():
    """Run all health checks."""
    parser = argparse.ArgumentParser(
        description="Health check for context-memory plugin"
    )
    parser.add_argument(
        "-v", "--verbose",
        action="store_true",
        help="Show detailed output"
    )
    args = parser.parse_args()

    print("Context-Memory Health Check")
    print("=" * 40)

    checks = [
        check_git(args.verbose),
        check_write_permissions(args.verbose),
        check_disk_space(args.verbose),
        check_hook_installed(args.verbose),
    ]

    print("=" * 40)
    passed = sum(checks)
    total = len(checks)

    if all(checks):
        print(f"✅ All checks passed ({passed}/{total})")
        sys.exit(0)
    else:
        print(f"❌ {total - passed}/{total} checks failed")
        print()
        print("Common fixes:")
        print("  • Git not found: Install git from https://git-scm.com")
        print("  • Permissions: Check .claude directory ownership")
        print("  • Hook not configured: Run plugin setup again")
        sys.exit(1)


if __name__ == "__main__":
    main()
